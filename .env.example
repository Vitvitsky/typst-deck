# Настройки typst-deck. Скопируйте в .env (он в .gitignore) и заполните.
# Сервис читает .env из текущего каталога, но только переменные с префиксом
# TYPST_DECK_: синонимы DEEPSEEK_* берутся лишь из настоящего окружения.
# Пустое значение = значение по умолчанию из src/typst_deck/config.py.

# --- Модель (OpenAI-совместимый API) ---
# Без ключа сервис стартует, ручная правка работает, генерация отвечает 503.
TYPST_DECK_LLM_API_KEY=
TYPST_DECK_LLM_API_BASE=https://api.deepseek.com
TYPST_DECK_LLM_MODEL=deepseek-chat
# Рассуждающим моделям нужен запас на рассуждение; 4096 им не хватает.
TYPST_DECK_LLM_MAX_TOKENS=16384
# tools — tool calling; json — запасной режим для эндпоинтов без tool calling.
TYPST_DECK_LLM_TOOL_MODE=tools

# --- Данные и шаблоны ---
TYPST_DECK_DATA_DIR=data
# Шаблон по умолчанию (id default).
TYPST_DECK_TEMPLATE_DIR=template
# Корни дополнительных шаблонов <корень>/<id>/deck.typ, несколько — через ":".
# При совпадении id побеждает первый корень.
TYPST_DECK_TEMPLATES_DIR=templates
# Старые id шаблонов: старый:новый[,старый2:новый2]
TYPST_DECK_TEMPLATE_ALIASES=
# Фоновая проверка шаблонов по контракту при старте.
TYPST_DECK_CHECK_TEMPLATES_ON_START=true

# --- Сервис ---
TYPST_DECK_TYPST_BIN=typst
# Внешний адрес сервиса: из него строятся pdf_url, pptx_url и edit_url агентского API.
TYPST_DECK_PUBLIC_BASE_URL=
TYPST_DECK_MAX_UPLOAD_MB=20
TYPST_DECK_LOG_LEVEL=INFO
# text — для человека; json — построчный JSON для сборщика логов.
TYPST_DECK_LOG_FORMAT=text

# --- Только для тестов ---
# Каталог со ссылками на корпоративные шаблоны; без него их тесты пропускаются.
# Задаётся в окружении при запуске pytest, сервис его не читает.
# TYPST_DECK_TEST_TEMPLATES=~/corp-templates
