# Корпоративный шаблон Lemana Tech: канон, компоненты и шрифты подтягивает scripts/sync-lmru-template.sh
# из закрытого репозитория и в git не хранятся. Адаптер контракта deck.typ и template.json — свои, они в git.
templates/lmru-hr/*
